# Kiwoom REST API
# 모의투자용 앱키/시크릿키/계좌번호를 발급받아 아래 3개에 입력하고, KIWOOM_USE_MOCK=true로 둡니다.
KIWOOM_APP_KEY=your-app-key
KIWOOM_SECRET_KEY=your-secret-key
KIWOOM_ACCOUNT_NO=your-account-number
KIWOOM_USE_MOCK=true

# Claude Code CLI / AI 모델 (진입 판단에만 사용)
ENTRY_MODEL=claude-sonnet-5
ENTRY_AGENT_TIMEOUT_SEC=180.0

# Slack 알림
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL_CONDITION=#stock-condition
SLACK_CHANNEL_HEALTH=#stock-health

# 매매 설정
TRADE_AMOUNT=500000
MAX_POSITIONS=3
MAX_DAILY_LOSS=300000

# 포지션 가드
GUARD_INTERVAL_SEC=5

# 분할매수/매도
SPLIT_TRADE_ENABLED=true
TRANCHE1_BUY_RATIO=0.6
TRANCHE2_PULLBACK_PCT=-0.5
TRANCHE2_MOMENTUM_PCT=0.3
TRANCHE2_TIMEOUT_SEC=180
QUICK_TARGET_PCT=1.5
QUICK_TARGET_SELL_RATIO=0.4

# 진입/청산 파라미터 (STRATEGY_MAP 미등록 조건식에 쓰이는 기본 전략)
TARGET_PCT=2.5
STOP_LOSS_PCT=-1.5
MAX_HOLD_MINUTES=15
MIN_CONFIDENCE=0.70
CHASE_BUY_LIMIT_PCT=1.0
SKIP_BEFORE_MIN=5
SKIP_AFTER_HOUR=14

# 트레일링 스탑
TRAILING_ACTIVATE_PCT=1.0
TRAILING_DROP_PCT=0.7

# 조건식 모니터링
CONDITION_IDS=
